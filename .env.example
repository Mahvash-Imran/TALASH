# LLM Provider Configuration (Groq — OpenAI-compatible)
# Copy this file to .env and fill in your values
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=groq/compound-mini

# Alternative: OpenAI directly
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- TALASH security settings ---
# Admin account password (if unset, a random one is generated into data/ADMIN_PASSWORD.txt)
TALASH_ADMIN_PASSWORD=change_me_to_a_long_random_password
# Comma-separated list of browser origins allowed to call the API cross-origin (blank = same-origin only)
TALASH_CORS_ORIGINS=
# Session lifetime in hours and max upload size in MB
TALASH_SESSION_HOURS=12
TALASH_MAX_UPLOAD_MB=100
