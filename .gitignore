# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment variables — NEVER commit real secrets
.env
.env.*
!.env.example

# Virtual environment
venv/
env/
.venv/

# Data files — keep directory structure (.gitkeep) but not actual data
data/extracted/*
!data/extracted/.gitkeep
data/logs/*
!data/logs/.gitkeep
data/cvs/*
!data/cvs/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/analysis/*.csv
data/analysis/jd_matches/*/

# Scratch and temp files
scratch/

# OS specific files
.DS_Store
Thumbs.db
