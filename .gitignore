# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment variables — NEVER commit real secrets
.env
.env.*
!.env.example

# Virtual environment
venv/
env/
.venv/

# Heavy raw PDFs and logs
data/cvs/*.pdf
data/cvs/split/*.pdf
data/uploads/*.pdf
data/logs/*
!data/logs/.gitkeep

# Scratch and temp files
scratch/

# OS specific files
.DS_Store
Thumbs.db
